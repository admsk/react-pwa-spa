          Comentario1 = "Apesar do nome, o pão francês como conhecemos hoje é uma criação brasileira inspirada em pães europeus (como a baguete), mas adaptada ao gosto local. Ele também é conhecido em algumas regiões do Brasil como pão de sal, pão careca, pão filão, pão cacetinho (no Sul), entre outros.",
          Comentario2 = @"Estima-se que mais de 25 milhões de unidades de pão francês sejam consumidas diariamente no Brasil.",
          Comentario3 =@"Já foi o vilão de dietas por causa dos carboidratos, mas em moderação, faz parte de uma alimentação equilibrada e saudável.",
          URL = "https://www.abip.org.br/site/padarias-do-brasil-comemoram-dia-mundial-do-pao-neste-16-de-outubro/?utm_source=chatgpt.com"
        },

        new Receita {
          ImagemUrl = "/Assets/images/broa-artigo.jpeg",
